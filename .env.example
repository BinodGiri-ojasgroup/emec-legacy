# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core -------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------
DB_NAME=emec
DB_USER=emec
DB_PASSWORD=emec
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Cache / sessions -----------------------------------------------------
REDIS_URL=redis://localhost:6379/1

# --- Email ------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@emec.com.np
SERVER_EMAIL=server@emec.com.np
INQUIRY_NOTIFY_EMAIL=info@emec.com.np

# --- Site ------------------------------------------------------------
SITE_DOMAIN=www.emec.com.np

# --- Production only ----------------------------------------------------
CSRF_TRUSTED_ORIGINS=https://www.emec.com.np
SENTRY_DSN=
SENDGRID_API_KEY=
USE_S3_MEDIA=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
